{
  "name": "@martinschmieschek/slopdogs-dogs-translate",
  "version": "0.2.0-beta.0",
  "description": "Translate: LibreTranslate (community instance, keyless)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "slopdogs": {
    "typeDefs": "dist/type-defs.json",
    "surface": "dist/surface.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinSchmieschek/SlopDogs.git",
    "directory": "packages/dogs-translate"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && slopdogs-typedefs build",
    "prepare": "node -e \"process.exit(require('fs').existsSync('../../tsconfig.packages.json') ? 0 : 1)\" || npm run build"
  },
  "peerDependencies": {
    "@martinschmieschek/slopdogs-core": "^0.2.0-beta.0"
  },
  "devDependencies": {
    "@martinschmieschek/slopdogs-core": "file:../core",
    "@martinschmieschek/slopdogs-typedefs": "file:../typedefs",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
