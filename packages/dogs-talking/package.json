{
  "name": "@martinschmieschek/slopdogs-dogs-talking",
  "version": "0.2.0-beta.0",
  "description": "TalkingDog und HTML-Layout-Renderer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "slopdogs": {
    "typeDefs": "dist/type-defs.json",
    "surface": "dist/surface.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinSchmieschek/SlopDogs.git",
    "directory": "packages/dogs-talking"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && slopdogs-typedefs build",
    "prepare": "node -e \"let p=require('path'),d=process.cwd();while(d!==(d=p.dirname(d)))try{if(require(p.join(d,'package.json')).workspaces)process.exit(0)}catch{}process.exit(1)\" || npm run build"
  },
  "peerDependencies": {
    "@martinschmieschek/slopdogs-core": "^0.2.0-beta.0",
    "@martinschmieschek/slopdogs-dogs-demo": "^0.2.0-beta.0"
  },
  "devDependencies": {
    "@martinschmieschek/slopdogs-core": "file:../core",
    "@martinschmieschek/slopdogs-dogs-demo": "file:../dogs-demo",
    "@martinschmieschek/slopdogs-typedefs": "file:../typedefs",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
