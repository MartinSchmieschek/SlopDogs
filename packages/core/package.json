{
  "name": "@martinschmieschek/slopdogs-core",
  "version": "0.2.0-beta.0",
  "description": "Kernpaket für das SlopDogs-System - enthält die grundlegenden Komponenten für die Orchestrierung und Ausführung von Data-Processing-Einheiten (Dogs)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "runtime": [
        "dist/runtime.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "slopdogs": {
    "typeDefs": "dist/type-defs.json",
    "surface": "dist/surface.json",
    "surfaceEntry": "src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinSchmieschek/SlopDogs.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "author": "Martin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && slopdogs-typedefs build",
    "prepare": "node -e \"let p=require('path'),d=process.cwd();while(d!==(d=p.dirname(d)))try{if(require(p.join(d,'package.json')).workspaces)process.exit(0)}catch{}process.exit(1)\" || npm run build"
  },
  "dependencies": {
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@martinschmieschek/slopdogs-typedefs": "file:../typedefs",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
