{
  "name": "@martinschmieschek/slopdogs-typedefs",
  "version": "0.2.0-beta.0",
  "description": "Typ-Werkzeug der SlopDogs-Pakete: dist/type-defs.json (Pact- und Klassen-Typen) und dist/surface.json (Vertragsoberflaeche) je Paket, dieselbe Extraktion wie der Server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "slopdogs-typedefs": "bin/slopdogs-typedefs.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "tsconfig.base.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinSchmieschek/SlopDogs.git",
    "directory": "packages/typedefs"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "node -e \"let p=require('path'),d=process.cwd();while(d!==(d=p.dirname(d)))try{if(require(p.join(d,'package.json')).workspaces)process.exit(0)}catch{}process.exit(1)\" || npm run build"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
