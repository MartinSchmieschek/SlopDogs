{
  "name": "slopdogs",
  "version": "0.2.0-beta.1",
  "description": "SlopDogs — dogs hunt data: Kennels, Waves, Serialized TypeScript in the void. Express, Angular, Prisma.",
  "main": "main.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinSchmieschek/SlopDogs.git"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "postinstall": "cross-env NODE_ENV=development node -r ./scripts/load-env.cjs ./scripts/postinstall-run.cjs",
    "build": "cross-env NODE_ENV=development node -r ./scripts/load-env.cjs ./scripts/run-build.cjs",
    "build:prod": "cross-env NODE_ENV=production node -r ./scripts/load-env.cjs ./scripts/run-build.cjs",
    "build:local": "cross-env NODE_ENV=production SLOPDOGS_MODE=local node -r ./scripts/load-env.cjs ./scripts/run-build.cjs && cross-env NODE_ENV=production SLOPDOGS_MODE=local npm run ui:build && cross-env NODE_ENV=production SLOPDOGS_MODE=local node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs --generate-only",
    "prisma:sync": "cross-env NODE_ENV=development node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs",
    "prisma:sync:prod": "cross-env NODE_ENV=production node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs",
    "prisma:sync:integration": "cross-env NODE_ENV=integration node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs",
    "prisma:sync:integration:reset": "cross-env NODE_ENV=integration PRISMA_SYNC_FORCE_RESET=1 node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs",
    "prisma:generate:env": "node -r ./scripts/load-env.cjs ./scripts/prisma-generate-matching-env.cjs",
    "dev": "npm run prisma:sync && node scripts/inject-ui-api-base.cjs && concurrently -n backend,ui -c blue,green \"cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=4096 node -r ./scripts/load-env.cjs -r ts-node/register main.ts\" \"npm run ui\"",
    "dev:reseed": "npm run prisma:sync && node scripts/inject-ui-api-base.cjs && concurrently -n backend,ui -c blue,green \"cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=4096 node -r ./scripts/load-env.cjs -r ts-node/register main.ts --reseed\" \"npm run ui\"",
    "start": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=4096 node -r ./scripts/load-env.cjs -r ts-node/register main.ts",
    "start:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 node -r ./scripts/load-env.cjs ./scripts/prisma-generate-matching-env.cjs && cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 node --expose-gc -r ./scripts/load-env.cjs dist/main.js",
    "start:local": "cross-env NODE_ENV=production SLOPDOGS_MODE=local node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs --push-only && cross-env NODE_ENV=production SLOPDOGS_MODE=local node --expose-gc -r ./scripts/load-env.cjs -r ./scripts/local-secrets.cjs dist/main.js",
    "start:local:reseed": "npm run start:local -- --reseed",
    "start:integration": "npm run prisma:sync:integration && cross-env NODE_ENV=integration node -r ./scripts/load-env.cjs -r ts-node/register main.ts",
    "start:integration:dist": "cross-env NODE_ENV=integration MALLOC_ARENA_MAX=2 MALLOC_MMAP_THRESHOLD_=131072 MALLOC_TRIM_THRESHOLD_=131072 NODE_OPTIONS=--max-old-space-size=320 node --expose-gc -r ./scripts/load-env.cjs dist/main.js",
    "start:integration:dist:sync": "npm run prisma:sync:integration && npm run start:integration:dist",
    "start:integration:node": "node --expose-gc --max-old-space-size=320 -r ./scripts/env-integration.cjs -r ./scripts/load-env.cjs dist/main.js",
    "prod": "npm run start:prod",
    "integration": "npm run start:integration",
    "ui": "node scripts/inject-ui-api-base.cjs && cd ui-app && npx ng serve --proxy-config proxy.conf.js --open",
    "ui:build": "cross-env NODE_ENV=production node scripts/inject-ui-api-base.cjs && cd ui-app && npx ng build",
    "ui:build:integration": "cross-env NODE_ENV=integration node scripts/inject-ui-api-base.cjs && cd ui-app && npx ng build",
    "render:integration:build": "npm ci && npm run build:prod && npm run ui:build:integration && npm run prisma:sync:integration",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "check:integration-dogs": "node -r ts-node/register scripts/check-integration-dog-coverage.cjs",
    "check:dog-packs": "node -r ts-node/register scripts/check-base-dog-packs.cjs",
    "check:env-catalog": "node scripts/check-env-catalog.cjs",
    "check:prisma-schemas": "node scripts/check-prisma-schemas.cjs",
    "update:dogs": "node scripts/update-dogs.cjs",
    "heap:registry-compare": "node scripts/compare-registry-heap.cjs",
    "lint:docs": "node -r ts-node/register scripts/check-doc-paths.cjs",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write . && node scripts/format-check.cjs --update",
    "format:check": "node scripts/format-check.cjs",
    "format:baseline": "node scripts/format-check.cjs --update",
    "test": "npm run typecheck && npm run check:integration-dogs && npm run check:dog-packs && npm run check:env-catalog && npm run check:prisma-schemas && npm run lint:docs && npm run lint && npm run format:check",
    "test:startup": "node scripts/run-startup-tests.cjs",
    "test:mcp:integration": "node mcp/integration/mcp-gateway.integration.cjs",
    "test:mcp:integration:int": "cross-env NODE_ENV=integration node -r ./scripts/load-env.cjs mcp/integration/mcp-gateway.integration.cjs"
  },
  "author": "Martin",
  "license": "MIT",
  "private": true,
