{
  "name": "slopdogs",
  "version": "0.2.0-beta.1",
  "description": "SlopDogs — dogs hunt data: Kennels, Waves, Serialized TypeScript in the void. Express, Angular, Prisma.",
  "main": "main.ts",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinSchmieschek/SlopDogs.git"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "postinstall": "cross-env NODE_ENV=development node -r ./scripts/load-env.cjs ./scripts/postinstall-run.cjs",
    "build:packages": "node scripts/check-package-references.cjs && tsc -b tsconfig.packages.json && node scripts/build-package-typedefs.cjs",
    "build": "cross-env NODE_ENV=development node -r ./scripts/load-env.cjs ./scripts/run-build.cjs",
    "build:prod": "cross-env NODE_ENV=production node -r ./scripts/load-env.cjs ./scripts/run-build.cjs",
    "build:local": "cross-env NODE_ENV=production SLOPDOGS_MODE=local node -r ./scripts/load-env.cjs ./scripts/run-build.cjs && cross-env NODE_ENV=production SLOPDOGS_MODE=local npm run ui:build && cross-env NODE_ENV=production SLOPDOGS_MODE=local node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs --generate-only",
    "prisma:sync": "cross-env NODE_ENV=development node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs",
    "prisma:sync:prod": "cross-env NODE_ENV=production node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs",
    "prisma:sync:integration": "cross-env NODE_ENV=integration node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs",
    "prisma:sync:integration:reset": "cross-env NODE_ENV=integration PRISMA_SYNC_FORCE_RESET=1 node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs",
    "prisma:generate:env": "node -r ./scripts/load-env.cjs ./scripts/prisma-generate-matching-env.cjs",
    "dev": "npm run prisma:sync && node scripts/inject-ui-api-base.cjs && concurrently -n backend,ui -c blue,green \"cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=4096 node -r ./scripts/load-env.cjs -r ts-node/register -r tsconfig-paths/register main.ts\" \"npm run ui\"",
    "start": "cross-env NODE_ENV=development NODE_OPTIONS=--max-old-space-size=4096 node -r ./scripts/load-env.cjs -r ts-node/register -r tsconfig-paths/register main.ts",
    "start:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 node -r ./scripts/load-env.cjs ./scripts/prisma-generate-matching-env.cjs && cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 node --expose-gc -r ./scripts/load-env.cjs dist/main.js",
    "start:local": "cross-env NODE_ENV=production SLOPDOGS_MODE=local node -r ./scripts/load-env.cjs ./scripts/run-prisma-sync.cjs --push-only && cross-env NODE_ENV=production SLOPDOGS_MODE=local node --expose-gc -r ./scripts/load-env.cjs -r ./scripts/local-secrets.cjs dist/main.js",
    "start:integration": "npm run prisma:sync:integration && cross-env NODE_ENV=integration node -r ./scripts/load-env.cjs -r ts-node/register -r tsconfig-paths/register main.ts",
    "start:integration:dist": "cross-env NODE_ENV=integration MALLOC_ARENA_MAX=2 MALLOC_MMAP_THRESHOLD_=131072 MALLOC_TRIM_THRESHOLD_=131072 NODE_OPTIONS=--max-old-space-size=320 node --expose-gc -r ./scripts/load-env.cjs dist/main.js",
    "start:integration:dist:sync": "npm run prisma:sync:integration && npm run start:integration:dist",
    "start:integration:node": "node --expose-gc --max-old-space-size=320 -r ./scripts/env-integration.cjs -r ./scripts/load-env.cjs dist/main.js",
    "prod": "npm run start:prod",
    "integration": "npm run start:integration",
    "ui": "node scripts/inject-ui-api-base.cjs && cd ui-app && npx ng serve --proxy-config proxy.conf.js --open",
    "ui:build": "cross-env NODE_ENV=production node scripts/inject-ui-api-base.cjs && cd ui-app && npx ng build",
    "ui:build:integration": "cross-env NODE_ENV=integration node scripts/inject-ui-api-base.cjs && cd ui-app && npx ng build",
    "render:integration:build": "npm ci && npm run build:prod && npm run ui:build:integration && npm run prisma:sync:integration",
    "typecheck": "npm run build:packages && tsc --noEmit -p tsconfig.build.json",
    "check:integration-dogs": "node -r ts-node/register -r tsconfig-paths/register scripts/check-integration-dog-coverage.cjs",
    "check:dog-packs": "node -r ts-node/register scripts/check-base-dog-packs.cjs",
    "check:env-catalog": "node scripts/check-env-catalog.cjs",
    "check:prisma-schemas": "node scripts/check-prisma-schemas.cjs",
    "update:dogs": "node scripts/update-dogs.cjs",
    "heap:registry-compare": "node scripts/compare-registry-heap.cjs",
    "lint:docs": "node -r ts-node/register scripts/check-doc-paths.cjs",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write . && node scripts/format-check.cjs --update",
    "format:check": "node scripts/format-check.cjs",
    "format:baseline": "node scripts/format-check.cjs --update",
    "test": "npm run typecheck && npm run check:integration-dogs && npm run check:dog-packs && npm run check:env-catalog && npm run check:prisma-schemas && npm run lint:docs && npm run lint && npm run format:check",
    "test:startup": "node scripts/run-startup-tests.cjs",
    "test:mcp:integration": "node mcp/integration/mcp-gateway.integration.cjs",
    "test:mcp:integration:int": "cross-env NODE_ENV=integration node -r ./scripts/load-env.cjs mcp/integration/mcp-gateway.integration.cjs"
  },
  "author": "Martin",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@martinschmieschek/slopdogs-core": "file:packages/core",
    "@martinschmieschek/slopdogs-dogs-air-quality": "file:packages/dogs-air-quality",
    "@martinschmieschek/slopdogs-dogs-animals-random": "file:packages/dogs-animals-random",
    "@martinschmieschek/slopdogs-dogs-astronomy": "file:packages/dogs-astronomy",
    "@martinschmieschek/slopdogs-dogs-biodiversity": "file:packages/dogs-biodiversity",
    "@martinschmieschek/slopdogs-dogs-birds": "file:packages/dogs-birds",
    "@martinschmieschek/slopdogs-dogs-charging": "file:packages/dogs-charging",
    "@martinschmieschek/slopdogs-dogs-crypto": "file:packages/dogs-crypto",
    "@martinschmieschek/slopdogs-dogs-cuisine": "file:packages/dogs-cuisine",
    "@martinschmieschek/slopdogs-dogs-currency": "file:packages/dogs-currency",
    "@martinschmieschek/slopdogs-dogs-demo": "file:packages/dogs-demo",
    "@martinschmieschek/slopdogs-dogs-dev": "file:packages/dogs-dev",
    "@martinschmieschek/slopdogs-dogs-dictionary": "file:packages/dogs-dictionary",
    "@martinschmieschek/slopdogs-dogs-gaming": "file:packages/dogs-gaming",
    "@martinschmieschek/slopdogs-dogs-geo": "file:packages/dogs-geo",
    "@martinschmieschek/slopdogs-dogs-geocoding": "file:packages/dogs-geocoding",
    "@martinschmieschek/slopdogs-dogs-github-trending": "file:packages/dogs-github-trending",
    "@martinschmieschek/slopdogs-dogs-health": "file:packages/dogs-health",
    "@martinschmieschek/slopdogs-dogs-historical-weather": "file:packages/dogs-historical-weather",
    "@martinschmieschek/slopdogs-dogs-holidays": "file:packages/dogs-holidays",
    "@martinschmieschek/slopdogs-dogs-hue": "file:packages/dogs-hue",
    "@martinschmieschek/slopdogs-dogs-humor": "file:packages/dogs-humor",
    "@martinschmieschek/slopdogs-dogs-images": "file:packages/dogs-images",
    "@martinschmieschek/slopdogs-dogs-ip-geo": "file:packages/dogs-ip-geo",
    "@martinschmieschek/slopdogs-dogs-knowledge": "file:packages/dogs-knowledge",
    "@martinschmieschek/slopdogs-dogs-music": "file:packages/dogs-music",
    "@martinschmieschek/slopdogs-dogs-name-insights": "file:packages/dogs-name-insights",
    "@martinschmieschek/slopdogs-dogs-open-library": "file:packages/dogs-open-library",
    "@martinschmieschek/slopdogs-dogs-phenology": "file:packages/dogs-phenology",
    "@martinschmieschek/slopdogs-dogs-pop-culture": "file:packages/dogs-pop-culture",
    "@martinschmieschek/slopdogs-dogs-public-transport": "file:packages/dogs-public-transport",
    "@martinschmieschek/slopdogs-dogs-quiz": "file:packages/dogs-quiz",
    "@martinschmieschek/slopdogs-dogs-random-fact": "file:packages/dogs-random-fact",
    "@martinschmieschek/slopdogs-dogs-regional-news": "file:packages/dogs-regional-news",
    "@martinschmieschek/slopdogs-dogs-religion": "file:packages/dogs-religion",
    "@martinschmieschek/slopdogs-dogs-season": "file:packages/dogs-season",
    "@martinschmieschek/slopdogs-dogs-social": "file:packages/dogs-social",
    "@martinschmieschek/slopdogs-dogs-space": "file:packages/dogs-space",
    "@martinschmieschek/slopdogs-dogs-sports": "file:packages/dogs-sports",
    "@martinschmieschek/slopdogs-dogs-sun": "file:packages/dogs-sun",
    "@martinschmieschek/slopdogs-dogs-talking": "file:packages/dogs-talking",
    "@martinschmieschek/slopdogs-dogs-transit-trips": "file:packages/dogs-transit-trips",
    "@martinschmieschek/slopdogs-dogs-translate": "file:packages/dogs-translate",
    "@martinschmieschek/slopdogs-dogs-travel": "file:packages/dogs-travel",
    "@martinschmieschek/slopdogs-dogs-tv": "file:packages/dogs-tv",
    "@martinschmieschek/slopdogs-dogs-warframe": "file:packages/dogs-warframe",
    "@martinschmieschek/slopdogs-dogs-water": "file:packages/dogs-water",
    "@martinschmieschek/slopdogs-dogs-weather": "file:packages/dogs-weather",
    "@martinschmieschek/slopdogs-dogs-web-archive": "file:packages/dogs-web-archive",
    "@martinschmieschek/slopdogs-dogs-webcams": "file:packages/dogs-webcams",
    "@martinschmieschek/slopdogs-dogs-wiki-search": "file:packages/dogs-wiki-search",
    "@martinschmieschek/slopdogs-dogs-wikipedia": "file:packages/dogs-wikipedia",
    "@martinschmieschek/slopdogs-geo-pact": "file:packages/geo-pact",
    "@martinschmieschek/slopdogs-swaggrid": "file:packages/swaggrid",
    "@martinschmieschek/slopdogs-typedefs": "file:packages/typedefs",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@prisma/client": "^5.5.0",
    "@types/express": "^5.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "jose": "^5.9.6",
    "openid-client": "^5.7.1",
    "sucrase": "^3.35.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "prisma": "^5.5.0",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "8.71.2"
  },
  "prisma": {
    "schema": "store/prisma/schema.prisma",
    "seed": "cross-env NODE_ENV=development node -r ./scripts/load-env.cjs -r ts-node/register -r tsconfig-paths/register seed-data/seed.ts"
  }
}
