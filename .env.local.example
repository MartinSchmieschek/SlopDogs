# =============================================================================
#  SlopDogs — lokaler Modus auf dem Pi (SLOPDOGS_MODE=local)
# =============================================================================
#
#  Auf dem Pi nach `.env.local` kopieren (gitignored):  cp .env.local.example .env.local
#  VOR `npm ci` — schon postinstall braucht die Datenbank-Variablen.
#
#  scripts/load-env.cjs laedt .env → .env.local → .env.production → .env.production.local;
#  spaetere Dateien ueberschreiben fruehere, auch Werte aus der Umgebung.
#
#  NODE_ENV und SLOPDOGS_MODE hier NICHT setzen: npm run build:local / start:local und die
#  systemd-Unit (deploy/pi/slopdogs.service) setzen NODE_ENV=production SLOPDOGS_MODE=local.
#
#  Alle Variablen mit Erklaerung: .env.example. Anleitung: README.md, Abschnitt „SlopDogs auf dem Pi".
#

# --- HTTP
#
# PORT — HTTP-Port; der Dienst lauscht im LAN (0.0.0.0), die Netzgrenze laesst nur private Adressen herein.
PORT=3000
#
# PUBLIC_API_BASE_URL — leer lassen: UI und API laufen auf demselben Host (same-origin).
#   Wenn gesetzt, nur mit privatem Host (z. B. http://slopdogs.local:3000) — ein oeffentlicher Host
#   bricht den Start ab (Exit 79). Wird beim UI-Build eingebacken.
# PUBLIC_API_BASE_URL=

# --- Datenbanken (SQLite, absolute Pfade im Datenverzeichnis des Dienstes)
#
#  Die DB-Art folgt der URL: file:… → SQLite-Schemas. npm run build:local legt die Dateien an.
#  Backup vor jedem Update: die *.db-Dateien (nicht das Schluessel-Verzeichnis, siehe unten).
DATABASE_URL="file:/var/lib/slopdogs/store.db"
CACHE_DATABASE_URL="file:/var/lib/slopdogs/cache.db"
JSON_STORAGE_DATABASE_URL="file:/var/lib/slopdogs/json-storage.db"
AUTH_DATABASE_URL="file:/var/lib/slopdogs/auth.db"

# --- Netzgrenze
#
# LOCAL_ALLOWED_HOSTS — weitere Host-Namen, kommagetrennt: name (mit PORT) oder name:port, IPv6 in [].
#   Default: hostname, hostname.local, alle Interface-IPs, localhost, 127.0.0.1, [::1] mit PORT.
#   Andere Host-Header und Origins antworten 403 (Schutz gegen DNS-Rebinding).
# LOCAL_ALLOWED_HOSTS=slopdogs.home.arpa,192.168.178.20:8080

# --- Schluessel
#
# SESSION_SECRET und KEYSTORE_MASTER_KEY_V1 nicht hier eintragen: scripts/local-secrets.cjs erzeugt
# sie beim ersten Start (je 32 Zufallsbytes hex) in LOCAL_SECRETS_FILE (Verzeichnis 0700, Datei 0600)
# und liest sie danach von dort. Der Master-Key liegt damit auf demselben Geraet wie das Chiffrat.
#
# LOCAL_SECRETS_FILE — Default: ~/.slopdogs/local-secrets.env; die Unit setzt /var/lib/slopdogs/secrets/local-secrets.env.
#   Nie innerhalb des Repos (sonst Exit 79).
# LOCAL_SECRETS_FILE=/var/lib/slopdogs/secrets/local-secrets.env

# --- Speicher — Vorschlag, ungemessen auf dem Pi
#
#  Defaults im Code (packages/core/src/dogs/DogWorkerGate.ts): Waechter ausserhalb development an,
#  Budget MEMORY_LIMIT_MB=512, Soft-Limit 85 % davon, DOG_WORKER_GLOBAL_LIMIT=2 Isolate gleichzeitig.
#  Auf einem Pi mit 4 GB waere mehr Luft — die Werte unten sind geschaetzt, nicht gemessen.
#
# MEMORY_LIMIT_MB=1024
# DOG_WORKER_GLOBAL_LIMIT=4
#
#  NODE_OPTIONS wirkt hier NICHT (der Node-Prozess laeuft schon, wenn diese Datei geladen wird) —
#  gehoert als Environment=NODE_OPTIONS=--max-old-space-size=768 in die systemd-Unit.
# NODE_OPTIONS=--max-old-space-size=768

# --- Heimnetz-Dogs (Beispiel: Philips Hue, Paket dogs-hue)
#
#  Nutzer-Code bleibt aus privaten Netzen gesperrt; ins Heimnetz gehen nur Base-Dogs aus Paketen.
# HUE_BRIDGE_HOST=192.168.178.30
# HUE_BRIDGE_USER=
# HUE_INTER_COMMAND_DELAY_MS=120

# --- Nicht setzen (Start bricht ab, Exit 79)
#
#  MCP_AUTH_REQUIRED=true      — der lokale Modus hat keinen Login
#  TRUST_PROXY_HOPS > 0        — kein Proxy davor; die Client-Adresse kommt vom Socket
#  RENDER                      — lokaler Modus nie auf Render
#  PUBLIC_API_BASE_URL mit oeffentlichem Host (erlaubt: Loopback, private IPs, localhost, *.local,
#  Hostnamen ohne Punkt, *.home.arpa)
