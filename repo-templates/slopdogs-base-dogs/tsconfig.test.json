{
  // Paket-Tests (node:test) gegen die gebauten Pakete: core kommt aus node_modules (Registry, Tarball oder Git-Tag),
  // die Dog-Pakete ueber ihre Workspace-Links — also genau das, was ein Server installiert.
  "extends": "@martinschmieschek/slopdogs-typedefs/tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "rootDir": "./test",
    "outDir": "./.test-build",
    "types": ["node"]
  },
  "include": ["test/**/*.ts"]
}
