{
  // Paket-Tests (node:test) gegen das gebaute Paket: die Tests importieren core ueber seinen Paketnamen, Node loest
  // das per Selbstreferenz ueber `exports` auf dist/ auf — genau die Einstiege, die der Server und die Dog-Pakete sehen.
  "extends": "./typedefs/tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "rootDir": "./test",
    "outDir": "./.test-build",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@martinschmieschek/slopdogs-core": ["./dist/index.d.ts"],
      "@martinschmieschek/slopdogs-core/runtime": ["./dist/runtime.d.ts"]
    }
  },
  "include": ["test/**/*.ts"]
}
