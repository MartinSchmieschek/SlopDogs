{
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinSchmieschek/slopdogs-core.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p typedefs/tsconfig.json && tsc -p tsconfig.json && node typedefs/bin/slopdogs-typedefs.cjs build",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\"",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "surface:check": "node scripts/surface-check.cjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-typedefs-version.cjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "eslint": "{{ESLINT_VERSION}}",
    "prettier": "{{PRETTIER_VERSION}}",
    "typescript": "{{TYPESCRIPT_VERSION}}",
    "typescript-eslint": "{{TYPESCRIPT_ESLINT_VERSION}}"
  }
}
