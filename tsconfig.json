{
  // Server, ts-node und Editor. Die Compiler-Basis (target, strict, Module) kommt aus tsconfig.base.json —
  // dieselbe wie fuer die Pakete unter packages/.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Der Server ist kein Projekt fuer tsc -b: er wird mit tsc -p tsconfig.emit.json gebaut (scripts/run-build.cjs).
    "composite": false,
    "declaration": false,
    /*
     * Welle 10 -- Build-Konfig-Fix.
     *
     * Dieser Root-tsconfig.json wird NIE zum Emit benutzt; er ist nur fuer
     * tooling (typecheck, editor, ts-node). Der produktive Build laeuft ueber
     * tsconfig.build.json -- dort wird `noEmit: false` + `outDir: ./dist` gesetzt
     * und ausschliesslich nach ./dist geschrieben.
     *
     * `noEmit: true` verhindert, dass ein versehentlicher `npx tsc` (ohne -p)
     * im Repo-Root .js-Schmutz neben jede .ts-Datei legt. ts-node/Node-Modul-
     * Resolution wuerden diese .js sonst gegenueber dem aktuellen .ts-Source
     * bevorzugen -- Geister-Debugging garantiert.
     */
    "noEmit": true,
    // dev und Typecheck loesen die Pakete auf ihre Quellen auf; der Emit (tsconfig.emit.json) leert die Pfade.
    "baseUrl": ".",
    "paths": {
      "@slopdogs/core": ["packages/core/src/index.ts"],
      "@slopdogs/swaggrid": ["packages/swaggrid/src/index.ts"],
      "@slopdogs/dogs-demo": ["packages/dogs-demo/src/index.ts"],
