{
  // Gemeinsame Compiler-Basis (PLAN-DOG-PAKETE P1.1): alle 54 Paket-tsconfigs unter packages/ erben davon,
  // der Root-tsconfig.json (Server, ts-node, Editor) ebenso. Hier steht nur, WIE uebersetzt wird; WO
  // (outDir, rootDir, include, references) traegt jede tsconfig selbst — relative Pfade gelten relativ
  // zu der Datei, die sie setzt.
  "compilerOptions": {
    // Node 22 (.nvmrc) kann ES2022 vollstaendig; async/await, ?. und ?? bleiben nativ statt Helfer-Code.
    "target": "ES2022",
    "lib": ["ES2022"],
    // Mit target ES2022 wuerde TypeScript Klassenfelder sonst nach [[Define]] ausgeben: ein im Unterklassen-
    // Rumpf nur deklariertes Feld (`foo: string;`) setzte nach super() den vom Basis-Konstruktor geschriebenen
    // Wert auf undefined zurueck. false haelt die Semantik des bisherigen es2016-Builds ([[Set]]).
    "useDefineForClassFields": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    // Pakete sind Projekte fuer `tsc -b` (P1.2): composite verlangt declaration und schreibt .tsbuildinfo.
    "declaration": true,
    "composite": true
  }
}
