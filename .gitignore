# Node modules
node_modules/

# Dev DB (SQLite)
dev.db
auth.db
store/prisma/*.db
store/prisma-auth/*.db

# Startup-Suite (npm run test:startup): eigene SQLite-Dateien neben den Schemas
test-startup*.db
test-startup*.db-journal

# Cache DB (SQLite)
cache.db
cache.db-shm
cache.db-wal

# Build output
dist/

# Welle 10 -- Stale TypeScript compile artifacts must never live next to .ts sources.
# A stray `npx tsc` (ohne -p tsconfig.build.json) wuerde sonst .js neben .ts legen
# und ts-node/Node-Modul-Resolution wuerden die alten .js gegenueber den frischen
# .ts bevorzugen -- Geister-Debugging garantiert.
/*.js
/api/**/*.js
/mcp/**/*.js
/services/**/*.js
/store/**/*.js

# Prisma client
node_modules/@prisma/
store/generated/

# env (mehrschichtig: .env, .env.local, .env.development, … — siehe scripts/load-env.cjs)
.env
.env.local
.env.integration
.env.*.local
.cursor/debug.log
store/prisma-json-storage/json-storage.db
.cursor/skills/slopdogs-api-workflow/SKILL.md
store/prisma-auth/auth.db

# Cursor IDE local config — not part of the repo
.cursor/
*.db-journal
